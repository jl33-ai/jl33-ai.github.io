//to match Quartz
$color-background = #fff // #FAF8F8

$color-footer-mobile-1 = darken($color-background, 2%)
$color-footer-mobile-2 = darken($color-background, 10%)
$color-background-code = darken($color-background, 2%)
$color-border = #8B7355
$color-scrollbar = #C9B5A0
$color-meta = #73645A
$color-meta-code = lighten($color-meta, 10%)
$color-link = #1528AB
$color-text = #3A3330
$color-accent-1 = #2C2622
$color-accent-2 = #1528AB
$color-accent-2-dark = #1528AB
$color-accent-3 = #9C8B7D
$color-accent-4 = #F4EDE4
$color-quote = #cc2a41
$highlight = hexo-config("highlight") || "github"
$dashed-border = 1px dashed $color-accent-4

//todo should change w/ screen size

$font-size-label = 0.85rem
$font-size-subtext = 0.7rem