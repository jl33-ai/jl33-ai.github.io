// Fonts
// To switch back to Input Mono, restore these two lines to:
//   $font-family-body = "Input Mono", "Meslo LG", monospace
//   $font-family-mono = "Input Mono", "Meslo LG", monospace
// and revert the @font-face block in _fonts.styl (see the comment there).
$font-family-body = "Sohne", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif
$font-family-mono = "Sohne Mono", "Input Mono", "Meslo LG", monospace
$font-size = 14px
$line-height = 1.725
$page-width = 0rem + (hexo-config("page_width") || 39)
// Logo
$logo-width = 0px + (hexo-config("logo.width") || 0)
$logo-height = 0px + (hexo-config("logo.height") || 0)
$logo-grayout = hexo-config("logo.grayout") || false
// Colors
$colors = hexo-config("colorscheme") || "dark"
