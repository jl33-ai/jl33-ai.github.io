//.tier-list

.tier-row
  display flex
  align-items center
  min-height 120px


.tier-grade
  padding: 2px 8px;
  font-weight 800;
  color white;
  cursor help
  transition transform 0.2s ease

  &:hover
    transform scale(1.05)

.shelf
  flex 1
  display flex
  gap 15px
  align-items center
  overflow-x auto
  padding 15px 20px

  &::-webkit-scrollbar
    height 8px

  &::-webkit-scrollbar-track
    background #f1f1f1
    border-radius 4px

  &::-webkit-scrollbar-thumb
    background #888
    border-radius 4px

    &:hover
      background #555

.book-wrapper
  position relative
  transition transform 0.1s ease-in-out

