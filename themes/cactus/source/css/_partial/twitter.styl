.twitter-item
  position relative
  padding-top 2rem
  padding-bottom 1rem
  display flex
  justify-content flex-start

  &:first-child
    padding-top 0


  .pfp
    cursor pointer
    flex-grow: 0
    cursor pointer
    padding 0.25rem 0.5rem

    img
      max-width: 32px
      aspect-ratio 1
      margin-right 0.2rem
      border-radius 1000px

  .content
    cursor pointer
    //background-color #9e86c8
    flex-grow 1
    align-items flex-start
    display flex
    flex-direction column
    gap 0

    a p
      margin-top 0 !important
      margin-bottom 0 !important

    .header
      font-size $font-size-label

      strong
        margin-right 0.35rem

      p
        margin-top 0 !important
        margin-bottom 0 !important
      display flex
      flex-direction row
      align-items center

      .primary
        color: $color-accent-1

      .secondary
        color: $color-accent-3

    .twitter-img
      border-radius: 0.33rem
      border: 0.075rem solid $color-accent-4
      max-height: 8rem

    .body
      margin-top 0 !important

      p
        margin-top 0 !important
        margin-bottom 0 !important
      color: $color-accent-1
      font-size: $font-size-label

    .icons
      width 85%
      display flex
      flex-direction row
      justify-content space-between

      .icon
        display flex
        align-items center
        gap 0.33rem

        img
          aspect-ratio 1
          max-width 10px
          opacity 45%

        p
          font-size 0.7rem
          color: $color-accent-3

  .pinned
    position absolute
    display flex
    top -1.2rem
    left 2.33rem

    img
      aspect-ratio 1
      max-width 10px
      opacity 45%
      margin-right 0.33rem

    strong
      font-size 0.7rem
      color: $color-accent-3
