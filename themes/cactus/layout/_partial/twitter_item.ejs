<% const __twitterPostKeyCandidate = post.twitter_id || post.path || post.permalink || post._id || post.slug || post.title; %>
<% const __twitterPostKey = __twitterPostKeyCandidate ? encodeURIComponent(__twitterPostKeyCandidate) : ''; %>
<div class="twitter-item item-with-border"
     data-post-key="<%- __twitterPostKey %>"
     onclick="window.location.href='<%- url_for(post.pdf || post.redirect_url || post.path) %>'">
    <% if (post.isPinned) { %>
        <div class="pinned">
            <img src="/images/twitter/pin.svg" alt="pin">
            <strong>Pinned</strong>
        </div>
    <% } %>
    <div class="pfp">
        <img src="/images/pfp/1_256.jpg" loading="lazy"/>
    </div>
    <div class="content">
        <div class="header">
            <strong>
                Justin
            </strong>
            <p class="secondary">
                @justin_lee
                <span>
                    <% if (!post.isPinned) { %>
                        ⸱ <%- makeDateString(post.date) %>
                    <% } %>
                </span>
            </p>
        </div>
        <p class="body"><%- post.title %></p>
        <% if (post.thumbnail) { %>
            <img class="twitter-img" src="<%- post.thumbnail %>"/>
        <% } %>
        <div class="icons">
            <div class="icon" data-metric="likes" data-scale="7">
                <img src="/images/twitter/heart.svg" alt="heart">
                <p class="metric-value"><%- getRandomNumber(7) %></p>
            </div>
            <div class="icon" data-metric="replies" data-scale="3">
                <img src="/images/twitter/message.svg" alt="heart">
                <p class="metric-value"><%- getRandomNumber(3) %></p>
            </div>
            <div class="icon" data-metric="retweets" data-scale="2">
                <img src="/images/twitter/retweet.svg" alt="heart">
                <p class="metric-value"><%- getRandomNumber(2) %></p>
            </div>
            <div class="icon" data-metric="shares" data-scale="1">
                <img src="/images/twitter/upload.svg" alt="heart">
                <p class="metric-value"><%- getRandomNumber(1) %></p>
            </div>
        </div>
    </div>
</div>
<% if (!locals.__twitterMetricsPersisted) { locals.__twitterMetricsPersisted = true; %>
<script>
    (function () {
        if (typeof window === 'undefined' || !window.localStorage) {
            return;
        }

        function persistMetricsForItem(item) {
            if (!item) return;

            var postKey = item.getAttribute('data-post-key');
            if (!postKey) return;

            var storageKey = 'twitterMetrics:' + postKey;
            var stored = {};

            try {
                var raw = window.localStorage.getItem(storageKey);
                if (raw) {
                    stored = JSON.parse(raw) || {};
                }
            } catch (err) {
                stored = {};
            }

            var icons = item.querySelectorAll('.icon[data-metric]');
            var updated = false;

            for (var i = 0; i < icons.length; i++) {
                var icon = icons[i];
                var metric = icon.getAttribute('data-metric');
                if (!metric) continue;

                var valueEl = icon.querySelector('.metric-value');
                if (!valueEl) continue;

                var value = stored[metric];
                if (typeof value !== 'number' || isNaN(value)) {
                    var currentValue = parseInt(valueEl.textContent, 10);
                    if (!isNaN(currentValue)) {
                        value = currentValue;
                    } else {
                        var scale = Number(icon.getAttribute('data-scale')) || 1;
                        value = Math.floor((scale * Math.random()) * scale + 0.5);
                    }
                    stored[metric] = value;
                    updated = true;
                }

                valueEl.textContent = value;
            }

            if (updated) {
                try {
                    window.localStorage.setItem(storageKey, JSON.stringify(stored));
                } catch (err) {
                    // ignore storage failures
                }
            }
        }

        function initTwitterMetricsPersistence() {
            var items = document.querySelectorAll('.twitter-item[data-post-key]');
            for (var i = 0; i < items.length; i++) {
                persistMetricsForItem(items[i]);
            }
        }

        initTwitterMetricsPersistence();

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initTwitterMetricsPersistence);
        }
    })();
</script>
<% } %>
