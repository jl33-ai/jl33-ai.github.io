<pre id="ascii-house" class="cover-ascii">
    <%
    const asciiArt = `
                                     (1   )
                                   (  0 0)
                                    ( 1 0 )
                                   ( 1  1 )
                                     ) 0 )
                                    (0  (                 /\\
                                     (_)                 /  \\  /\\
                             ________[_]________      /\\/    \\/  \\
                    /\\      /\\        ______    \\    /   /\\/\\  /\\/\\
                   /  \\    //_\\       \\    /\\    \\  /\\/\\/    \\/    \\
            /\\    / /\\/\\  //___\\       \\__/  \\    \\/
           /  \\  /\\/    \\//_____\\       \\ |[]|     \\
          /\\/\\/\\/       //_______\\       \\|__|      \\
         /      \\      /XXXXXXXXXX\\                  \\
                 \\    /_I_II  I__I_\\__________________\\
                        I_I|  I__I_____[]_|_[]_____I
                        I_II  I__I_____[]_|_[]_____I
                        I II__I  I     XXXXXXX     I
                     ~~~~~"   "~~~~~~~~~~~~~~~~~~~~~~~~

              >> build_me_a_house_out_of_1s_and_0s()
`;
    %>
    <%= asciiArt %>
</pre>


<script>
    (function () {
        const asciiHouse = document.getElementById('ascii-house');
        const intervalMs = <%= typeof flipInterval !== 'undefined' ? flipInterval : 1000 %>;
        const flipProbability = <%= typeof flipProbability !== 'undefined' ? flipProbability : 0.1 %>;

        function flipDigits() {
            let content = asciiHouse.innerHTML;
            content = content.replace(/[01]/g, match => {
                return Math.random() < flipProbability ? (match === '0' ? '1' : '0') : match;
            });
            asciiHouse.innerHTML = content;
        }

        setInterval(flipDigits, intervalMs);
    })();
</script>