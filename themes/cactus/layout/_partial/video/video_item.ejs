<div class="video-item">
    <div class="upper">
        <div class="youtube-container" data-video-id="<%= video_id %>">
            <img class="youtube-thumbnail"
                 src="https://img.youtube.com/vi/<%= video_id %>/maxresdefault.jpg"
                 alt="Video thumbnail">

            <div class="youtube-player-slot"></div>

            <p class="lozenge">
                <%= length %>
            </p>
        </div>
    </div>

    <div class="lower">
        <div class="pfp">
            <img src="/images/pfp/2_256.jpg"/>
        </div>
        <div class="info">
            <h3 class="video-title">
                <a class="video-title-a" href="https://www.youtube.com/watch?v=<%= video_id %>">
                    <%= title %>
                </a>
            </h3>
            <div class="subtext">
                <!--                <p>-->
                <!--                    <%= 'Justin Lee' %>-->
                <!--                </p>-->
                <p>
                    <%= get_date_string(created_at) %>
                </p>
            </div>
        </div>
        <div
                data-description="<%= description %>"
                class="ellipsis tooltip">
            ...
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        tippy('.tooltip', {
            content(reference) {
                const description = reference.getAttribute('data-description');
                return `<span
                            style="font-size: 10px"
                        >${description || ''}</span>`;
            },
            allowHTML: true,
            placement: 'left',
            delay: [67, 0],
            arrow: false,
            theme: 'translucent'
        });
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.youtube-container').forEach(function (container) {
            var videoId = container.dataset.videoId;
            var thumbnail = container.querySelector('.youtube-thumbnail');
            var lozenge = container.querySelector('.lozenge');
            var playerSlot = container.querySelector('.youtube-player-slot');
            var hoverTimeout = null;
            var leaveTimeout = null;
            var isVideoLoaded = false;
            var isHovering = false;

            function loadVideo() {
                if (isVideoLoaded) return;

                isVideoLoaded = true;
                thumbnail.style.opacity = '0';
                lozenge.style.opacity = '0';

                var iframe = document.createElement('iframe');
                iframe.className = 'youtube-iframe';
                iframe.width = '100%';
                iframe.height = '100%';
                iframe.allow = 'autoplay; encrypted-media';
                iframe.allowFullscreen = true;
                iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&controls=1&showinfo=0&modestbranding=1&loop=1&playlist=${videoId}&rel=0`;

                playerSlot.appendChild(iframe);
            }

            function unloadVideo() {
                if (!isVideoLoaded) return;

                playerSlot.innerHTML = '';
                isVideoLoaded = false;
                thumbnail.style.opacity = '1';
                lozenge.style.opacity = '1';
            }

            container.addEventListener('mouseenter', function () {
                isHovering = true;

                // Clear any pending leave operation
                if (leaveTimeout) {
                    clearTimeout(leaveTimeout);
                    leaveTimeout = null;
                }

                // If video is already loaded, nothing to do
                if (isVideoLoaded) return;

                // Clear any existing hover timeout
                if (hoverTimeout) {
                    clearTimeout(hoverTimeout);
                }

                // Delay loading to prevent accidental triggers
                hoverTimeout = setTimeout(function () {
                    // Only load if still hovering
                    if (isHovering) {
                        loadVideo();
                    }
                    hoverTimeout = null;
                }, 250);
            });

            container.addEventListener('mouseleave', function () {
                isHovering = false;

                // Clear any pending hover operation
                if (hoverTimeout) {
                    clearTimeout(hoverTimeout);
                    hoverTimeout = null;
                }

                // If no video is loaded, nothing to clean up
                if (!isVideoLoaded) return;

                // Delay unloading to allow for quick re-entry
                if (leaveTimeout) {
                    clearTimeout(leaveTimeout);
                }

                leaveTimeout = setTimeout(function () {
                    // Only unload if still not hovering
                    if (!isHovering) {
                        unloadVideo();
                    }
                    leaveTimeout = null;
                }, 2500);
            });
        });
    });
</script>